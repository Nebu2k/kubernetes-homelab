# Template for the unsealed secret. The feeder ID identifies this receiver at
# FlightAware, so it does not go into the repo.
#
# A new ID comes from the container itself, it asks FlightAware for one on
# first start:
#
#   kubectl run piaware-feederid --rm --restart=Never \
#     --image=ghcr.io/sdr-enthusiasts/docker-piaware:latest \
#     -- sleep 60
#   kubectl logs piaware-feederid | grep "my feeder ID"
#
# Afterwards claim the receiver at https://flightaware.com/adsb/piaware/claim,
# that is what links it to the account and unlocks the free Enterprise plan.
apiVersion: v1
kind: Secret
metadata:
  name: piaware-secret
  namespace: piaware
type: Opaque
stringData:
  feeder-id: "00000000-0000-0000-0000-000000000000"
