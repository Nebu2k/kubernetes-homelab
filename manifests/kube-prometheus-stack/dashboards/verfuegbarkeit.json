{
  "title": "Verfügbarkeit und Zertifikate (Gatus)",
  "uid": "homelab-verfuegbarkeit",
  "description": "Die Historie zu status.elmstreet79.de. Gatus selbst zeigt nur die letzten Checks, hier liegen sie mit 30 Tagen Retention. Wichtig zur Einordnung: die Uptime-Werte sind Mittelwerte ueber gatus_results_endpoint_success, also ueber das Ergebnis des letzten Checks zum jeweiligen Scrape-Zeitpunkt. Ein Ausfall, der kuerzer ist als der Scrape-Abstand, kann darin fehlen. Wer die exakte Zahl der Fehlversuche braucht, nimmt das Panel Fehlversuche pro Stunde, das zaehlt den Counter statt zu mitteln.",
  "tags": ["homelab", "gatus", "verfuegbarkeit"],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Endpoints",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "count(max by (key) (gatus_results_endpoint_success))",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "text" } },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "aktuell rot",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "count(max by (key) (gatus_results_endpoint_success) == 0) or vector(0)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Uptime 24h (alle)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "avg(avg_over_time(gatus_results_endpoint_success[24h]))",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.98 },
              { "color": "green", "value": 0.999 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Nächster Cert-Ablauf",
      "description": "Restlaufzeit des am fruehesten ablaufenden Zertifikats, so wie Gatus es von aussen sieht. Fast alle internen Hosts teilen das Wildcard-Cert *.elmstreet79.de, das cert-manager per DNS-01 erneuert. Ausnahmen sind die Endpoints, die auf fremde Zertifikate zeigen.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "min(gatus_results_certificate_expiration_seconds)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 604800 },
              { "color": "green", "value": 1209600 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Nächster Domain-Ablauf",
      "description": "Registrierungslaufzeit der ueberwachten Domains, nicht der Zertifikate. Kommt aus dem WHOIS-Check von Gatus.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "min(gatus_results_domain_expiration_seconds)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 2592000 },
              { "color": "green", "value": 5184000 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Endpoints",
      "description": "Das and on (key) in den Zeitfenster-Queries ist kein Beiwerk: ein Endpoint, der aus der Gatus-Konfiguration entfernt wurde, liefert noch bis zum Ende der Retention Werte fuer 24h und 7d. Ohne den Filter stehen hier Zeilen ohne Namen und ohne Status, die aussehen wie ein kaputter Check.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 13, "w": 24, "x": 0, "y": 4 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max by (key, name, group) (gatus_results_endpoint_success)",
          "format": "table",
          "instant": true
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "avg by (key) (avg_over_time(gatus_results_endpoint_success[24h])) and on (key) (max by (key) (gatus_results_endpoint_success))",
          "format": "table",
          "instant": true
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "avg by (key) (avg_over_time(gatus_results_endpoint_success[7d])) and on (key) (max by (key) (gatus_results_endpoint_success))",
          "format": "table",
          "instant": true
        },
        {
          "refId": "D",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max by (key) (gatus_results_duration_seconds)",
          "format": "table",
          "instant": true
        },
        {
          "refId": "E",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (key) (increase(gatus_results_total{success=\"false\"}[24h])) and on (key) (max by (key) (gatus_results_endpoint_success))",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        { "id": "joinByField", "options": { "byField": "key", "mode": "outer" } },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "Time 5": true,
              "key": true
            },
            "renameByName": {
              "group": "Gruppe",
              "name": "Endpoint",
              "Value #A": "Status",
              "Value #B": "Uptime 24h",
              "Value #C": "Uptime 7d",
              "Value #D": "Antwortzeit",
              "Value #E": "Fehler 24h"
            },
            "indexByName": {
              "group": 0,
              "name": 1,
              "Value #A": 2,
              "Value #B": 3,
              "Value #C": 4,
              "Value #D": 5,
              "Value #E": 6
            }
          }
        },
        { "id": "sortBy", "options": { "fields": {}, "sort": [{ "field": "Uptime 24h" }] } }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "auto" } },
          "unit": "none",
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Status" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "1": { "text": "up", "color": "green", "index": 0 } } },
                  { "type": "value", "options": { "0": { "text": "DOWN", "color": "red", "index": 1 } } }
                ]
              },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": "Uptime.*" },
            "properties": [
              { "id": "unit", "value": "percentunit" },
              { "id": "decimals", "value": 3 },
              { "id": "max", "value": 1 },
              { "id": "min", "value": 0 },
              { "id": "custom.cellOptions", "value": { "type": "gauge", "mode": "gradient" } },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "red", "value": null },
                    { "color": "yellow", "value": 0.98 },
                    { "color": "green", "value": 0.999 }
                  ]
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Antwortzeit" },
            "properties": [
              { "id": "unit", "value": "s" },
              { "id": "decimals", "value": 3 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Fehler 24h" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "yellow", "value": 1 },
                    { "color": "red", "value": 10 }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "footer": { "show": false, "reducer": ["sum"], "countRows": false, "fields": "" }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Fehlversuche pro Stunde",
      "description": "Zaehlt den Counter gatus_results_total mit success=false, ist damit unabhaengig vom Scrape-Zeitpunkt und die genauere Sicht als die Uptime-Mittelwerte.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 17 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (name) (increase(gatus_results_total{success=\"false\"}[1h])) > 0",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60,
            "showPoints": "never",
            "stacking": { "mode": "normal", "group": "A" }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum"], "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Erreichbarkeit pro Gruppe (24h-Mittel)",
      "description": "Die Gruppen kommen aus der Gatus-Konfiguration: Cluster, Infrastruktur, DNS, Internet, Domains.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 17 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "avg by (group) (avg_over_time(gatus_results_endpoint_success[24h]))",
          "legendFormat": "{{group}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 0, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["min", "mean"], "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Antwortzeiten",
      "description": "Die Dauer des letzten Checks je Endpoint. Bei den externen Hosts steckt der Weg ueber Traefik mit drin, die Werte sind also nicht direkt mit den internen vergleichbar.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 25 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max by (name) (gatus_results_duration_seconds)",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 0, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"], "showLegend": true, "sortBy": "Max", "sortDesc": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 10,
      "type": "table",
      "title": "Zertifikate und Domains",
      "description": "Restlaufzeiten. Die Cert-Spalte ist voll fuer jeden HTTPS-Endpoint, die Domain-Spalte nur fuer die Endpoints der Gruppe Domains, die per WHOIS geprueft werden.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 35 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max by (key, name, group) (gatus_results_certificate_expiration_seconds)",
          "format": "table",
          "instant": true
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max by (key) (gatus_results_domain_expiration_seconds)",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        { "id": "joinByField", "options": { "byField": "key", "mode": "outer" } },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "Time 1": true, "Time 2": true, "key": true },
            "renameByName": {
              "group": "Gruppe",
              "name": "Endpoint",
              "Value #A": "Cert läuft ab in",
              "Value #B": "Domain läuft ab in"
            },
            "indexByName": { "group": 0, "name": 1, "Value #A": 2, "Value #B": 3 }
          }
        },
        { "id": "sortBy", "options": { "fields": {}, "sort": [{ "field": "Cert läuft ab in" }] } }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "color-text" } },
          "unit": "s",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 604800 },
              { "color": "green", "value": 1209600 }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "Gruppe|Endpoint" },
            "properties": [
              { "id": "unit", "value": "none" },
              { "id": "custom.cellOptions", "value": { "type": "auto" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Domain läuft ab in" },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "red", "value": null },
                    { "color": "yellow", "value": 2592000 },
                    { "color": "green", "value": 5184000 }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "footer": { "show": false, "reducer": ["sum"], "countRows": false, "fields": "" }
      }
    }
  ]
}
