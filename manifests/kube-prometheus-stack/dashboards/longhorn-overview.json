    {
      "id": 12,
      "type": "row",
      "title": "Volumes",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "panels": []
    },
    {
      "id": 13,
      "type": "table",
      "title": "Volumes",
      "description": "Ein Eintrag pro Volume. Belegung ist der Fuellstand des Dateisystems im Volume, dieselbe Groesse, auf der LonghornVolumeSpaceWarning (80 Prozent) und LonghornVolumeSpaceCritical (90 Prozent) sitzen. Auf Disk ist etwas anderes: der Platz, den Longhorn je Replik wirklich belegt, mit Snapshots und ohne Rueckgabe nach dem Loeschen von Dateien. Der Wert kann deutlich hoeher liegen als die Belegung und ist trotzdem kein Grund zur Sorge. Backups stehen auf dem Board Backups (Longhorn und Offsite).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (volume, pvc, pvc_namespace, node) (longhorn_volume_capacity_bytes)",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (volume) (\n  label_replace(\n    kubelet_volume_stats_used_bytes\n      * on (namespace, persistentvolumeclaim) group_left(persistentvolume)\n        label_replace(\n          label_replace(\n            max by (claim_namespace, name, persistentvolume) (kube_persistentvolume_claim_ref),\n            \"namespace\", \"$1\", \"claim_namespace\", \"(.*)\"),\n          \"persistentvolumeclaim\", \"$1\", \"name\", \"(.*)\"),\n    \"volume\", \"$1\", \"persistentvolume\", \"(.*)\"))\nand on (volume) (max by (volume) (longhorn_volume_capacity_bytes))",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (volume) (\n  label_replace(\n    100 * kubelet_volume_stats_used_bytes / kubelet_volume_stats_capacity_bytes\n      * on (namespace, persistentvolumeclaim) group_left(persistentvolume)\n        label_replace(\n          label_replace(\n            max by (claim_namespace, name, persistentvolume) (kube_persistentvolume_claim_ref),\n            \"namespace\", \"$1\", \"claim_namespace\", \"(.*)\"),\n          \"persistentvolumeclaim\", \"$1\", \"name\", \"(.*)\"),\n    \"volume\", \"$1\", \"persistentvolume\", \"(.*)\"))\nand on (volume) (max by (volume) (longhorn_volume_capacity_bytes))",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (volume) (longhorn_volume_actual_size_bytes)",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count by (volume) (longhorn_engine_replica_mode{mode=\"RW\"})",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "F",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (volume) (longhorn_volume_robustness{state=\"healthy\"})",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "G",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (volume) (longhorn_volume_state{state=\"attached\"})",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "volume",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "Time 5": true,
              "Time 6": true,
              "Time 7": true,
              "volume": true
            },
            "renameByName": {
              "pvc_namespace": "Namespace",
              "pvc": "PVC",
              "node": "Attached auf",
              "Value #A": "Kapazität",
              "Value #B": "Belegt",
              "Value #C": "Belegung",
              "Value #D": "Auf Disk",
              "Value #E": "Repliken RW",
              "Value #F": "Robustheit",
              "Value #G": "Zustand"
            },
            "indexByName": {
              "pvc_namespace": 0,
              "pvc": 1,
              "node": 2,
              "Value #A": 3,
              "Value #B": 4,
              "Value #C": 5,
              "Value #D": 6,
              "Value #E": 7,
              "Value #F": 8,
              "Value #G": 9
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Belegung",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          },
          "unit": "none",
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(Kapazität|Belegt|Auf Disk)$"
            },
            "properties": [
              {
                "id": "unit",
