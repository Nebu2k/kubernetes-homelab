    {
      "id": 14,
      "type": "stat",
      "title": "Freshness-Check (täglich)",
      "description": "Alter des letzten erfolgreichen offsite-backup-freshness-Jobs. Schwellen wie OffsiteBackupNotArriving (48h). Nur dieser Job schaut in die Buckets statt auf Job-Ergebnisse.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
