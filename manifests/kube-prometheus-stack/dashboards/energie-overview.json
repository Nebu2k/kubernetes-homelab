{
  "title": "Energie",
  "uid": "homelab-energie",
  "description": "Strom im Haus aus den hass_*-Sensoren: die beiden eigenen Balkonkraftwerke, Tibber Pulse an beiden Zaehlern, Ecoflow am Rack und die Wallbox. Die Anlage im Gartenhaus gehoert Mama und steht deshalb unten in einer eigenen Zeile, nie in einer Summe. Alle Queries filtern auf entity und nie auf friendly_name: ein Sprachwechsel in HA hat pro Sensor eine zweite, veraltete friendly_name-Serie hinterlassen, die max by (entity) hier heraushaelt.",
  "tags": [
    "homelab",
    "energie",
    "home-assistant"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Jetzt",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "PV jetzt",
      "description": "AC-Leistung der beiden eigenen Wechselrichter, Balkon Ost und Balkon West. Ohne Gartenhaus.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(max by (entity) (hass_sensor_power_w{job=\"home-assistant\",entity=~\"sensor.inverter_ac_power(_3)?\"}))",
          "legendFormat": "PV",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "text", "value": null },
              { "color": "green", "value": 50 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
