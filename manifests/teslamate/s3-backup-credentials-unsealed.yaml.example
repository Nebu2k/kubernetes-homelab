# Credentials of the Teslamate offsite backup.
#
# The IAM user "homelab-teslamate-backup" and its policy come from
# homelab-terraform/aws/iam-backup-consumers.tf. Terraform deliberately does
# NOT create the access key, which would put the secret into the Terraform
# state: create it once in the AWS console and paste it here.
#
# Then seal it:
#   kubeseal --format=yaml --controller-namespace=kube-system \
#     < manifests/teslamate/s3-backup-credentials-unsealed.yaml \
#     > manifests/teslamate/s3-backup-credentials-sealed.yaml
#
# The *-unsealed.yaml is gitignored and stays on disk: SealedSecrets cannot be
# decrypted again, so without it there is no source left to reseal from.
---
apiVersion: v1
kind: Secret
metadata:
  name: s3-teslamate-backup-credentials
  namespace: teslamate
type: Opaque
stringData:
  AWS_ACCESS_KEY_ID: "AKIA..."
  AWS_SECRET_ACCESS_KEY: "..."
  S3_BUCKET_NAME: "homelab-teslamate-backup"
  S3_REGION: "eu-central-1"
