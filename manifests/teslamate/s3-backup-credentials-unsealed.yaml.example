# Zugangsdaten des Teslamate-Offsite-Backups.
#
# Der IAM-User "homelab-teslamate-backup" und seine Policy kommen aus
# homelab-terraform/terraform/aws/iam-backup-consumers.tf. Den Access Key dazu
# erzeugt Terraform BEWUSST NICHT (sonst laege das Secret im Terraform-State),
# er wird einmal in der AWS-Konsole angelegt und hier eingetragen.
#
# Danach versiegeln:
#   kubeseal --format=yaml --controller-namespace=kube-system \
#     < manifests/teslamate/s3-backup-credentials-unsealed.yaml \
#     > manifests/teslamate/s3-backup-credentials-sealed.yaml
#
# Die *-unsealed.yaml ist gitignored und bleibt liegen: SealedSecrets sind nicht
# rueckentschluesselbar, ohne diese Datei gibt es keine Reseal-Quelle mehr.
---
apiVersion: v1
kind: Secret
metadata:
  name: s3-teslamate-backup-credentials
  namespace: teslamate
type: Opaque
stringData:
  AWS_ACCESS_KEY_ID: "AKIA..."
  AWS_SECRET_ACCESS_KEY: "..."
  S3_BUCKET_NAME: "homelab-teslamate-backup"
  S3_REGION: "eu-central-1"
