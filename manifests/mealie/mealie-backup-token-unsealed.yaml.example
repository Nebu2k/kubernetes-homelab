# Template. Copy the real values to mealie-backup-token-unsealed.yaml
# (gitignored), then seal:
#
#   kubeseal --format=yaml --controller-namespace=kube-system \
#     < mealie-backup-token-unsealed.yaml \
#     > mealie-backup-token-sealed.yaml
#
# The token is created in the Mealie UI under Profile -> API tokens and MUST
# belong to an admin account: /api/admin/backups is an admin route and answers
# a normal account with 403.
#
# Kept separate from the S3 secret on purpose: a different kind of credential
# with a different rotation path (Mealie UI instead of the AWS console).
apiVersion: v1
kind: Secret
metadata:
  name: mealie-backup-token
  namespace: mealie
type: Opaque
stringData:
  MEALIE_API_TOKEN: "..."
