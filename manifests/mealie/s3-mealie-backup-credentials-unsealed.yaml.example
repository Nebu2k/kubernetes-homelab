# Vorlage. Echte Werte nach s3-mealie-backup-credentials-unsealed.yaml kopieren
# (gitignored), dann versiegeln:
#
#   kubeseal --format=yaml --controller-namespace=kube-system \
#     < s3-mealie-backup-credentials-unsealed.yaml \
#     > s3-mealie-backup-credentials-sealed.yaml
#
# Der Access Key gehoert dem IAM-User "homelab-mealie-backup" aus
# homelab-terraform/aws/iam-backup-consumers.tf. Terraform legt den Key NICHT an
# (kein iam:CreateAccessKey, sonst laege das Secret im State), er entsteht in der
# AWS-Konsole.
apiVersion: v1
kind: Secret
metadata:
  name: s3-mealie-backup-credentials
  namespace: mealie
type: Opaque
stringData:
  AWS_ACCESS_KEY_ID: "AKIA..."
  AWS_SECRET_ACCESS_KEY: "..."
  S3_BUCKET_NAME: "homelab-mealie-backup"
  S3_REGION: "eu-central-1"
