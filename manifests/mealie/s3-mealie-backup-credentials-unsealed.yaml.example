# Template. Copy the real values to s3-mealie-backup-credentials-unsealed.yaml
# (gitignored), then seal:
#
#   kubeseal --format=yaml --controller-namespace=kube-system \
#     < s3-mealie-backup-credentials-unsealed.yaml \
#     > s3-mealie-backup-credentials-sealed.yaml
#
# The access key belongs to the IAM user "homelab-mealie-backup" from
# homelab-terraform/aws/iam-backup-consumers.tf. Terraform deliberately does
# NOT create it, which would put the secret into the state: create it in the
# AWS console.
apiVersion: v1
kind: Secret
metadata:
  name: s3-mealie-backup-credentials
  namespace: mealie
type: Opaque
stringData:
  AWS_ACCESS_KEY_ID: "AKIA..."
  AWS_SECRET_ACCESS_KEY: "..."
  S3_BUCKET_NAME: "homelab-mealie-backup"
  S3_REGION: "eu-central-1"
