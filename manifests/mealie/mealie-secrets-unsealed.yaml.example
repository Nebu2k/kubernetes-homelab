# kubeseal --format=yaml --controller-namespace=kube-system < manifests/mealie/mealie-secrets-unsealed.yaml > manifests/mealie/mealie-secrets-sealed.yaml
#
# Mealie itself needs no secret. The first superuser is hardwired in the image
# and CANNOT be preset through environment variables: DEFAULT_EMAIL and
# DEFAULT_PASSWORD are private fields in settings.py. Change both in the UI
# right after the first login instead of putting them here.
---
apiVersion: v1
kind: Secret
metadata:
  name: postgresql-secrets
  namespace: mealie
type: Opaque
stringData:
  POSTGRES_DB: "mealie"
  POSTGRES_USER: "mealie"
  POSTGRES_PASSWORD: "CHANGE_ME_DB_PASSWORD"
