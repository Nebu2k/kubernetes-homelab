# kubeseal --format=yaml --controller-namespace=kube-system < manifests/mealie/mealie-secrets-unsealed.yaml > manifests/mealie/mealie-secrets-sealed.yaml
#
# Mealie selbst braucht kein Secret. Der erste Superuser ist im Image fest
# verdrahtet (changeme@example.com / MyPassword) und laesst sich NICHT per
# Env-Var vorbelegen: DEFAULT_EMAIL und DEFAULT_PASSWORD sind in settings.py
# private Felder. Beides gehoert deshalb direkt nach dem ersten Login in der
# UI geaendert, nicht hier hinein.
---
apiVersion: v1
kind: Secret
metadata:
  name: postgresql-secrets
  namespace: mealie
type: Opaque
stringData:
  POSTGRES_DB: "mealie"
  POSTGRES_USER: "mealie"
  POSTGRES_PASSWORD: "CHANGE_ME_DB_PASSWORD"
