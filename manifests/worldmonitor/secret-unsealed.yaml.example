# kubeseal --format=yaml --controller-namespace=kube-system < manifests/worldmonitor/secret-unsealed.yaml > manifests/worldmonitor/secret-sealed.yaml
#
# Die drei oberen Werte sind stackintern und werden erzeugt, nicht besorgt:
#   openssl rand -hex 32
# Alle drei sind Pflicht. Fehlt REDIS_PASSWORD oder REDIS_TOKEN, starten Redis
# bzw. der REST-Proxy nicht; ohne RELAY_SHARED_SECRET beendet sich das Relay
# im Start mit FATAL.
#
# Die API-Keys darunter sind alle optional und alle kostenlos. Leer lassen ist
# erlaubt: der zugehoerige Seeder meldet dann SKIP und die betroffene Kachel
# bleibt leer. Der Schluessel selbst muss aber existieren, weil die Deployments
# ihn per secretKeyRef ziehen.
---
apiVersion: v1
kind: Secret
metadata:
  name: worldmonitor
  namespace: worldmonitor
type: Opaque
stringData:
  REDIS_PASSWORD: ""        # openssl rand -hex 32
  REDIS_TOKEN: ""           # openssl rand -hex 32
  RELAY_SHARED_SECRET: ""   # openssl rand -hex 32

  GROQ_API_KEY: ""          # console.groq.com — KI-Einschaetzungen im Dashboard
  NASA_FIRMS_API_KEY: ""    # https://firms.modaps.eosdis.nasa.gov/api/map_key/ — Waldbrand-Erkennung
  FRED_API_KEY: ""          # fred.stlouisfed.org/docs/api/api_key.html — US-Wirtschaftsdaten
  EIA_API_KEY: ""           # eia.gov/opendata — Energiestatistik
  AISSTREAM_API_KEY: ""     # aisstream.io — Schiffsverkehr, sonst leere Seekarte
