# kubeseal --format=yaml --controller-namespace=kube-system < manifests/home-assistant/s3-archive-credentials-unsealed.yaml > manifests/home-assistant/s3-archive-credentials-sealed.yaml
#
# Its own IAM user "homelab-home-assistant-archive" from
# homelab-terraform/aws/iam-backup-consumers.tf. It may list, read and write in
# the HA bucket but NOT delete: it must not be able to remove the very archive
# states this job creates.
#
# So HA's own key does NOT belong here, although it is the same bucket. Mixing
# the two silently hands the job DeleteObject back and takes HA's retention
# away.
---
apiVersion: v1
kind: Secret
metadata:
  name: s3-archive-credentials
  namespace: home-assistant
type: Opaque
stringData:
  AWS_ACCESS_KEY_ID: "AKIA..."
  AWS_SECRET_ACCESS_KEY: "..."
  S3_BUCKET_NAME: "homelab-homeassistent-elmstreet79"
  S3_REGION: "eu-central-1"
