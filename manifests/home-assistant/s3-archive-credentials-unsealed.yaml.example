# kubeseal --format=yaml --controller-namespace=kube-system < manifests/home-assistant/s3-archive-credentials-unsealed.yaml > manifests/home-assistant/s3-archive-credentials-sealed.yaml
#
# Eigener IAM-User "homelab-home-assistant-archive" seit 2026-08-05, angelegt in
# homelab-terraform/terraform/aws/iam-backup-consumers.tf. Er darf im HA-Bucket
# listen, lesen und schreiben, aber NICHT loeschen: genau die Archivstaende, die
# dieser Job anlegt, soll er nicht wieder entfernen koennen.
#
# Hier gehoert deshalb NICHT der Key von HA selbst hinein, auch wenn es derselbe
# Bucket ist. Wer die beiden vertauscht, gibt dem Job stillschweigend
# DeleteObject zurueck und nimmt HA die Retention weg.
---
apiVersion: v1
kind: Secret
metadata:
  name: s3-archive-credentials
  namespace: home-assistant
type: Opaque
stringData:
  AWS_ACCESS_KEY_ID: "AKIA..."
  AWS_SECRET_ACCESS_KEY: "..."
  S3_BUCKET_NAME: "homelab-homeassistent-elmstreet79"
  S3_REGION: "eu-central-1"
