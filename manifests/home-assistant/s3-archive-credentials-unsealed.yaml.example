# kubeseal --cert sealed-secrets-pub-cert.pem --format=yaml < manifests/home-assistant/s3-archive-credentials-unsealed.yaml > manifests/home-assistant/s3-archive-credentials-sealed.yaml
#
# Derselbe IAM-Key, den auch paperless-ngx und HA selbst benutzen. Das ist
# bewusst ein Zwischenstand: laut Backup-Plan gehoert der Key rotiert und pro
# Konsument getrennt, mit bucket-scoped Policy. Dieser Job ist dann der dritte
# Konsument und faellt bei der Rotation mit an.
---
apiVersion: v1
kind: Secret
metadata:
  name: s3-archive-credentials
  namespace: home-assistant
type: Opaque
stringData:
  AWS_ACCESS_KEY_ID: "AKIA..."
  AWS_SECRET_ACCESS_KEY: "..."
  S3_BUCKET_NAME: "homelab-homeassistent-elmstreet79"
  S3_REGION: "eu-central-1"
