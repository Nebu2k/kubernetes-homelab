# Zugangsdaten, mit denen der etcd-Backup-CronJob des Talos-Clusters seine
# Snapshots nach S3 laedt.
#
# Bewusst DERSELBE IAM-User wie beim k3s-Cluster ("homelab-etcd-backup" aus
# homelab-terraform/aws/iam-backup-consumers.tf) und derselbe Bucket: es ist
# derselbe Zweck, und die Policy erlaubt genau Put/Get/List/DeleteObject darauf.
# Ein zweiter User waere ein zweiter Schluessel zum Rotieren ohne Gewinn.
#
# Anders als bei k3s liest hier ein POD das Secret und nicht der Node-Prozess.
# Die Schluesselnamen sind deshalb frei waehlbar und nach den AWS-Env-Variablen
# benannt, statt nach k3s-CLI-Flags.
#
# Namespace kube-system, weil dort auch das von Talos ausgestellte talosconfig
# landet: machine.features.kubernetesTalosAPIAccess.allowedKubernetesNamespaces
# in talos/talconfig.yaml laesst genau diesen einen Namespace zu.
#
# Danach versiegeln:
#   KUBECONFIG=talos/clusterconfig/kubeconfig kubeseal --format=yaml \
#     --controller-namespace=kube-system \
#     < manifests/etcd-backup/s3-credentials-unsealed.yaml \
#     > manifests/etcd-backup/s3-credentials-sealed.yaml
#
# Die *-unsealed.yaml ist gitignored und bleibt liegen: SealedSecrets sind nicht
# rueckentschluesselbar, ohne diese Datei gibt es keine Reseal-Quelle mehr.
---
apiVersion: v1
kind: Secret
metadata:
  name: etcd-backup-s3
  namespace: kube-system
type: Opaque
stringData:
  AWS_ACCESS_KEY_ID: "AKIA..."
  AWS_SECRET_ACCESS_KEY: "..."
  AWS_DEFAULT_REGION: "eu-central-1"
  ETCD_BUCKET: "homelab-etcd-snapshots-elmstreet79"
