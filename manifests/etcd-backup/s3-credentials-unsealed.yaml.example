# Credentials the etcd backup CronJob uses to upload its snapshots to S3.
#
# IAM user "homelab-etcd-backup" from
# homelab-terraform/aws/iam-backup-consumers.tf, whose policy allows exactly
# Put/Get/List/DeleteObject on this bucket.
#
# The secret is read by a POD, not by a node process, hence the key names
# match the AWS environment variables.
#
# Namespace kube-system, because the talosconfig Talos issues lands there too:
# machine.features.kubernetesTalosAPIAccess.allowedKubernetesNamespaces in
# talos/talconfig.yaml permits exactly this one namespace.
#
# Then seal it:
#   KUBECONFIG=talos/clusterconfig/kubeconfig kubeseal --format=yaml \
#     --controller-namespace=kube-system \
#     < manifests/etcd-backup/s3-credentials-unsealed.yaml \
#     > manifests/etcd-backup/s3-credentials-sealed.yaml
#
# The *-unsealed.yaml is gitignored and stays on disk: SealedSecrets cannot be
# decrypted again, so without it there is no source left to reseal from.
---
apiVersion: v1
kind: Secret
metadata:
  name: etcd-backup-s3
  namespace: kube-system
type: Opaque
stringData:
  AWS_ACCESS_KEY_ID: "AKIA..."
  AWS_SECRET_ACCESS_KEY: "..."
  AWS_DEFAULT_REGION: "eu-central-1"
  ETCD_BUCKET: "homelab-etcd-snapshots-elmstreet79"
