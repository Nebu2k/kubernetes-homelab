# kubeseal --format=yaml --controller-namespace=kube-system < manifests/proxmox-exporter/pve-api-credentials-unsealed.yaml > manifests/proxmox-exporter/pve-api-credentials-sealed.yaml
---
apiVersion: v1
kind: Secret
metadata:
  name: pve-api-credentials
  namespace: monitoring
type: Opaque
stringData:
  # Proxmox API user (user@pam or user@pve). Create a monitoring user with the
  # PVEAuditor role.
  username: "monitoring@pve!exporter"
  
  # API token secret, created under Datacenter -> Permissions -> API Tokens.
  # Only the UUID, NOT the full PVEAPIToken= string.
  password: "xxxxxxxxxxxxxxx"
  
  # Hostname or IP of the Proxmox host itself, without scheme or port.
  target: "192.168.2.8"