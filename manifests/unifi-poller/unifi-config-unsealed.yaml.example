# kubeseal --format=yaml --controller-namespace=kube-system < manifests/unifi-poller/unifi-config-unsealed.yaml > manifests/unifi-poller/unifi-config-sealed.yaml
---
apiVersion: v1
kind: Secret
metadata:
  name: unifi-poller-config
  namespace: monitoring
type: Opaque
stringData:
  up.conf: |
    [poller]
        debug = false
        quiet = false
        plugins = []
        
    [prometheus]
        disable = false
        http_listen = "0.0.0.0:9130"
        report_errors = false
        namespace = "unpoller"
        # Since v3 /metrics is served from a cache that a background poller
        # refreshes at this interval. Without the key unpoller polls per
        # /metrics call, and since the liveness and readiness probes also hit
        # /metrics that multiplies the controller polls. 30s matches the
        # ServiceMonitor interval; faster is pointless because the controller
        # only advances its traffic statistics every ~30s.
        interval = "30s"
        
    [influxdb]
        disable = true
        
    [loki]
        disable = true
        
    [unifi]
        dynamic = false
        
    [[unifi.controller]]    
        url         = "https://unifi.elmstreet79.de"
        user        = "YOUR-USERNAME"
        pass        = "YOUR-PASSWORD"
        sites       = ["all"]
        save_ids    = true
        save_dpi    = true
        save_sites  = true
        hash_pii    = false
        verify_ssl  = false
