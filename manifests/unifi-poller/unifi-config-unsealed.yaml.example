# kubeseal --format=yaml --controller-namespace=kube-system < manifests/unifi-poller/unifi-config-unsealed.yaml > manifests/unifi-poller/unifi-config-sealed.yaml
---
apiVersion: v1
kind: Secret
metadata:
  name: unifi-poller-config
  namespace: monitoring
type: Opaque
stringData:
  up.conf: |
    [poller]
        debug = false
        quiet = false
        plugins = []
        
    [prometheus]
        disable = false
        http_listen = "0.0.0.0:9130"
        report_errors = false
        namespace = "unpoller"
        # Ab v3: /metrics wird aus einem Cache bedient, den ein
        # Hintergrund-Poller in diesem Takt erneuert. Ohne den Schluessel
        # pollt unpoller pro /metrics-Aufruf, und da die Liveness- und
        # Readiness-Sonden ebenfalls auf /metrics gehen, waren das ~10
        # Controller-Polls/min statt 2. 30s deckt sich mit dem
        # ServiceMonitor-Intervall; schneller ist sinnlos, weil der
        # Controller seine Traffic-Statistik nur alle ~30s fortschreibt.
        interval = "30s"
        
    [influxdb]
        disable = true
        
    [loki]
        disable = true
        
    [unifi]
        dynamic = false
        
    [[unifi.controller]]    
        url         = "https://unifi.elmstreet79.de"
        user        = "YOUR-USERNAME"
        pass        = "YOUR-PASSWORD"
        sites       = ["all"]
        save_ids    = true
        save_dpi    = true
        save_sites  = true
        hash_pii    = false
        verify_ssl  = false
