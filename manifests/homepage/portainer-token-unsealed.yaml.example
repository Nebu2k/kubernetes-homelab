# kubeseal --format=yaml --controller-namespace=kube-system < manifests/homepage/portainer-token-unsealed.yaml > manifests/homepage/portainer-token-sealed.yaml
---
apiVersion: v1
kind: Secret
metadata:
  name: homepage-portainer
  namespace: homepage
type: Opaque
stringData:
  token: "ptr_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
