# Vorlage. Kopieren nach nas-cifs-secret-unsealed.yaml (gitignored), echte Werte
# eintragen, dann versiegeln:
#
#   kubeseal --cert sealed-secrets-pub-cert.pem --format=yaml \
#     < manifests/longhorn/nas-cifs-secret-unsealed.yaml \
#     > manifests/longhorn/nas-cifs-secret-sealed.yaml
#
# Danach nas-cifs-secret-sealed.yaml in die kustomization.yaml aufnehmen und in
# values.yaml defaultBackupStore umstellen:
#
#   backupTarget: "cifs://192.168.2.6/<share-name>"
#   backupTargetCredentialSecret: longhorn-nas-cifs-secret
#
# Die unsealed-Datei NICHT loeschen: SealedSecrets sind nicht rueckentschluesselbar,
# sie ist die Quelle fuers Neuversiegeln (siehe reseal-all-secrets.sh).
---
apiVersion: v1
kind: Secret
metadata:
  name: longhorn-nas-cifs-secret
  namespace: longhorn-system
type: Opaque
stringData:
  # Dediziertes NAS-Konto nur fuer Longhorn-Backups, nicht das eigene.
  # Braucht Lese- UND Schreibrecht auf dem Share.
  CIFS_USERNAME: your-nas-user
  CIFS_PASSWORD: your-nas-password
  # Optional, nur bei domaenengebundenen Shares. Sonst weglassen.
  # CIFS_DOMAIN: WORKGROUP
