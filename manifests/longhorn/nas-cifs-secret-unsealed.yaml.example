# Template. Copy to nas-cifs-secret-unsealed.yaml (gitignored), fill in the
# real values, then seal:
#
#   kubeseal --format=yaml --controller-namespace=kube-system \
#     < manifests/longhorn/nas-cifs-secret-unsealed.yaml \
#     > manifests/longhorn/nas-cifs-secret-sealed.yaml
#
# Then add nas-cifs-secret-sealed.yaml to kustomization.yaml and point
# defaultBackupStore in values.yaml at it:
#
#   backupTarget: "cifs://192.168.2.6/<share-name>"
#   backupTargetCredentialSecret: longhorn-nas-cifs-secret
#
# Do NOT delete the unsealed file: SealedSecrets cannot be decrypted again and
# it is the source for resealing (see reseal-all-secrets.sh).
---
apiVersion: v1
kind: Secret
metadata:
  name: longhorn-nas-cifs-secret
  namespace: longhorn-system
type: Opaque
stringData:
  # A dedicated NAS account for the Longhorn backups, not a personal one.
  # Needs read AND write access on the share.
  CIFS_USERNAME: your-nas-user
  CIFS_PASSWORD: your-nas-password
  # Optional, only for domain-joined shares. Leave out otherwise.
  # CIFS_DOMAIN: WORKGROUP
