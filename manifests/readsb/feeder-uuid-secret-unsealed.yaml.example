# Template for the unsealed secret. The UUID identifies this receiver at every
# aggregator readsb feeds directly, so it does not go into the repo.
#
# Any UUID works, it is self-assigned: "uuidgen | tr 'A-Z' 'a-z'". Replacing it
# starts a new feeder at the aggregators and drops the statistics history.
apiVersion: v1
kind: Secret
metadata:
  name: feeder-uuid-secret
  namespace: adsb
type: Opaque
stringData:
  uuid: "00000000-0000-0000-0000-000000000000"
