# Vorlage fuer das unversiegelte Secret. Die echten Werte gehoeren NICHT ins
# Repo: das sind die Koordinaten des Hauses und das Repo ist public.
#
# Ausfuellen, versiegeln, das unversiegelte wieder loeschen:
#
#   cp manifests/readsb/readsb-secret-unsealed.yaml.example \
#      manifests/readsb/readsb-secret-unsealed.yaml
#   $EDITOR manifests/readsb/readsb-secret-unsealed.yaml
#   kubeseal --format=yaml --controller-namespace=kube-system \
#     < manifests/readsb/readsb-secret-unsealed.yaml \
#     > manifests/readsb/readsb-secret-sealed.yaml
#   rm manifests/readsb/readsb-secret-unsealed.yaml
#
# Ultrafeeder braucht alle drei, sonst startet der Container nicht.
# alt akzeptiert Meter oder Fuss, also z.B. "45m" oder "148ft".
apiVersion: v1
kind: Secret
metadata:
  name: readsb-secret
  namespace: adsb
type: Opaque
stringData:
  lat: "51.0000"
  lon: "7.0000"
  alt: "50m"
