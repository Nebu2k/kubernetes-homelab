# Template for the unsealed secret. The real values must NOT go into the repo:
# these are the house coordinates and the repo is public.
#
# Fill in, seal, delete the unsealed file again:
#
#   cp manifests/readsb/readsb-secret-unsealed.yaml.example \
#      manifests/readsb/readsb-secret-unsealed.yaml
#   $EDITOR manifests/readsb/readsb-secret-unsealed.yaml
#   kubeseal --format=yaml --controller-namespace=kube-system \
#     < manifests/readsb/readsb-secret-unsealed.yaml \
#     > manifests/readsb/readsb-secret-sealed.yaml
#   rm manifests/readsb/readsb-secret-unsealed.yaml
#
# Ultrafeeder needs all three or the container does not start.
# alt accepts metres or feet, e.g. "45m" or "148ft".
apiVersion: v1
kind: Secret
metadata:
  name: readsb-secret
  namespace: adsb
type: Opaque
stringData:
  lat: "51.0000"
  lon: "7.0000"
  alt: "50m"
