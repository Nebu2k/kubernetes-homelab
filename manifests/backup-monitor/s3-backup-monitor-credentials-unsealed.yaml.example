# Zugangsdaten der Offsite-Backup-Frische-Sonde.
#
# Der IAM-User "homelab-backup-monitor" und seine Policy kommen aus
# homelab-terraform/terraform/aws/iam-backup-consumers.tf. Er darf ausschliesslich
# s3:ListBucket auf die drei Backup-Buckets, sonst nichts. Den Access Key dazu
# erzeugt Terraform BEWUSST NICHT (sonst laege das Secret im Terraform-State),
# er wird einmal in der AWS-Konsole angelegt und hier eingetragen.
#
# Danach versiegeln:
#   kubeseal --format=yaml --controller-namespace=kube-system \
#     < manifests/backup-monitor/s3-backup-monitor-credentials-unsealed.yaml \
#     > manifests/backup-monitor/s3-backup-monitor-credentials-sealed.yaml
#
# Die *-unsealed.yaml ist gitignored und bleibt liegen: SealedSecrets sind nicht
# rueckentschluesselbar, ohne diese Datei gibt es keine Reseal-Quelle mehr.
---
apiVersion: v1
kind: Secret
metadata:
  name: s3-backup-monitor-credentials
  namespace: monitoring
type: Opaque
stringData:
  AWS_ACCESS_KEY_ID: "AKIA..."
  AWS_SECRET_ACCESS_KEY: "..."
  S3_REGION: "eu-central-1"
  PAPERLESS_BUCKET: "homelab-paperless-backup"
  HOME_ASSISTANT_BUCKET: "homelab-homeassistent-elmstreet79"
  TESLAMATE_BUCKET: "homelab-teslamate-backup"
  ETCD_BUCKET: "homelab-etcd-snapshots-elmstreet79"
