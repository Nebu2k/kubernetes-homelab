# Credentials of the offsite backup freshness probe.
#
# The IAM user "homelab-backup-monitor" and its policy come from
# homelab-terraform/aws/iam-backup-consumers.tf and may do nothing but
# s3:ListBucket on the three backup buckets. Terraform deliberately does NOT
# create the access key, which would put the secret into the Terraform state:
# create it once in the AWS console and paste it here.
#
# Then seal it:
#   kubeseal --format=yaml --controller-namespace=kube-system \
#     < manifests/backup-monitor/s3-backup-monitor-credentials-unsealed.yaml \
#     > manifests/backup-monitor/s3-backup-monitor-credentials-sealed.yaml
#
# The *-unsealed.yaml is gitignored and stays on disk: SealedSecrets cannot be
# decrypted again, so without it there is no source left to reseal from.
---
apiVersion: v1
kind: Secret
metadata:
  name: s3-backup-monitor-credentials
  namespace: monitoring
type: Opaque
stringData:
  AWS_ACCESS_KEY_ID: "AKIA..."
  AWS_SECRET_ACCESS_KEY: "..."
  S3_REGION: "eu-central-1"
  PAPERLESS_BUCKET: "homelab-paperless-backup"
  HOME_ASSISTANT_BUCKET: "homelab-homeassistent-elmstreet79"
  TESLAMATE_BUCKET: "homelab-teslamate-backup"
  ETCD_BUCKET: "homelab-etcd-snapshots-elmstreet79"
  MEALIE_BUCKET: "homelab-mealie-backup"
