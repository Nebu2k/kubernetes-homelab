{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',

  extends: [
    'config:recommended',
    ':dependencyDashboard',
    // Keeps the curl-installed tool versions in
    // .github/workflows/validate.yml current. It matches the pattern
    // "# renovate: datasource=... depName=..." above a *_VERSION line.
    'customManagers:githubActionsVersions',
  ],

  timezone: 'Europe/Berlin',

  // Deliberately NO "schedule:" here. When Renovate runs is decided solely by
  // the cron in .github/workflows/renovate.yml; otherwise a manual
  // workflow_dispatch outside the window would silently do nothing.

  semanticCommits: 'enabled',

  // Open the PR at once instead of waiting for a green branch status.
  // config:recommended brings prNotPending, which would push the branch, wait
  // for its status checks and only then open the PR. But validate.yml runs on
  // pull_request only, never on a branch push, so the branches would wait for
  // a check that never comes and pile up under "Pending Status Checks".
  prCreation: 'immediate',

  // The default stays "no automerge". It is enabled per packageRule only,
  // never globally, because ArgoCD runs with selfHeal + prune and a merged
  // mistake is in the cluster immediately.
  automerge: false,

  // Renovate merges ITSELF through the API instead of using GitHub's
  // auto-merge. That is the condition for the validate gate to have any effect
  // at all: GitHub auto-merges as soon as all *required* status checks are
  // green, but main is not branch-protected here, so there are no required
  // checks and auto-merge would merge at once, bypassing validate.yml.
  //
  // Renovate instead reads the branch's check status actively and merges only
  // on green. The price is that merging happens only DURING a Renovate run,
  // which is why the cron runs daily rather than weekly.
  platformAutomerge: false,

  // Belongs directly to platformAutomerge: false and must not go back to
  // "auto" without it.
  //
  // With automerge enabled the default "auto" means "behind-base-branch":
  // Renovate rebases every automerge-capable branch as soon as main moves,
  // and main moves on every push plus every README commit from docs.yml. The
  // rebase resets the status checks, which take longer than the Renovate run
  // itself, so Renovate never sees the green state: run N rebases, CI goes
  // green after the run ends, run N+1 rebases again.
  //
  // With "conflicted" it rebases only on a real merge conflict. The branch
  // stays green and the next run merges it. The price is merging a branch
  // validated against a slightly older main; for image tag patches that is a
  // pod restart, and Renovate still catches genuine conflicts.
  rebaseWhen: 'conflicted',

  // No flood of PRs on the first run. The dependency dashboard still shows
  // everything, only fewer PRs are kept open at once.
  prConcurrentLimit: 5,
  prHourlyLimit: 2,

  // Let fresh tags age three days. Catches withdrawn and obviously broken
  // releases before they reach the cluster.
  minimumReleaseAge: '3 days',

  // Both need explicit paths, neither applies by default. (The github-actions
  // manager, in contrast, finds .github/workflows/ on its own.)

  // ArgoCD Applications: Helm charts via chart: + targetRevision:
  argocd: {
    managerFilePatterns: ['apps/**/*.yaml'],
  },

  // Kustomize manifests: image: tags in Deployments/StatefulSets/CronJobs
  kubernetes: {
    managerFilePatterns: ['manifests/**/*.yaml'],
  },

  // Anything that appears neither in an image: field nor in a chart is wired
  // up through a "# renovate:" comment line above it, the same way the
  // githubActionsVersions preset does for the workflows.
  customManagers: [
    // Talos and Kubernetes version of the cluster. Both live in
    // talos/talconfig.yaml, which no manager knows: it is neither a manifest
    // nor a Helm chart but the source talhelper generates the machine configs
    // from.
    //
    // A reminder, not a rollout: the merge changes nothing in the cluster, the
    // upgrade remains "talhelper genconfig" plus "talosctl upgrade" node by
    // node.
    //
    // kubernetesVersion comes along here and carries the skip-level rule: only
    // ONE minor at a time. The lock for that is in the packageRules below.
    {
      customType: 'regex',
      managerFilePatterns: ['talos/talconfig.yaml'],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+\\S+:\\s*(?<currentValue>\\S+)',
      ],
    },
  ],

  packageRules: [
    // Cluster-relevant updates as "fix(deps): ...", so a glance at the log
    // separates them from repo tooling.
    //
    // This MUST be a packageRule and must not sit as a top-level
    // semanticCommitType: config:recommended pulls in
    // :semanticPrefixFixDepsChoreOthers, which sets the type to "chore" via a
    // packageRule, and packageRules beat top-level config, so a top-level
    // value would be silently overridden.
    {
      matchManagers: ['argocd', 'kubernetes'],
      semanticCommitType: 'fix',
      semanticCommitScope: 'deps',
    },

    // Workflow actions are repo tooling, not cluster state.
    {
      matchManagers: ['github-actions'],
      semanticCommitType: 'chore',
      semanticCommitScope: 'ci',
    },

    // The ArgoCD Applications reference this repo itself as an additional
    // source (ref: values, targetRevision: main). Renovate sees that as a
    // git-tags dependency and would replace "main" with the newest tag,
    // pinning ArgoCD to a fixed tag and destroying the tracking of main. The
    // repo carries no tags today, so nothing matches, but the guard stays:
    // one tag would be enough to break it.
    {
      matchPackageNames: [
        'https://github.com/Nebu2k/kubernetes-homelab',
        'https://github.com/Nebu2k/kubernetes-homelab.git',
      ],
      enabled: false,
    },

    // fr24 tags with a monotonically increasing build counter. Not semver,
    // but unambiguously comparable once Renovate is told where the number is.
    // Side effect of the anchor: the parallel upstream schemes (1.0.30-1,
    // latest_arm64, *_nohealthcheck) do not match and drop out, keeping us on
    // the latest-build line.
    //
    // Note that the number lands as "major", so every update is formally a
    // major bump and never automerges. That is intended.
    {
      matchPackageNames: [
        'ghcr.io/sdr-enthusiasts/docker-flightradar24',
        // Ultrafeeder tags by the same scheme.
        'ghcr.io/sdr-enthusiasts/docker-adsb-ultrafeeder',
      ],
      versioning: 'regex:^latest-build-(?<major>\\d+)$',
    },

    // paperless-ngx and unpoller have no major lock of their own. Automerge
    // still stays off for paperless (rule further down): even patch releases
    // can carry migrations, and personal documents hang off it.

    // Talos: same construction as the ArgoCD anchor. The merge rolls nothing
    // out, so "chore" rather than a "fix(deps)" claiming an upgrade that has
    // not happened.
    //
    // ghcr.io/siderolabs/talosctl belongs IN this group: the image takes the
    // etcd snapshots in manifests/etcd-backup/ and must match the nodes' Talos
    // version, and two separate PRs would let them drift apart unnoticed.
    {
      matchPackageNames: [
        'siderolabs/talos',
        'ghcr.io/siderolabs/talosctl',
      ],
      groupName: 'talos',
      semanticCommitType: 'chore',
      semanticCommitScope: 'talos',
    },

    // The Kubernetes version from talconfig.yaml: offer patches only. The
    // skip-level rule allows only ONE minor at a time and Renovate does not
    // know it. The jump belongs together with talosVersion, plus KUBE_VERSION
    // in .github/scripts/validate.sh.
    {
      matchPackageNames: ['kubernetes/kubernetes'],
      matchUpdateTypes: ['minor', 'major'],
      enabled: false,
    },

    // A Postgres update should be one decision, not three PRs. Affects
    // teslamate and paperless (the -alpine variant there).
    {
      matchDatasources: ['docker'],
      matchPackageNames: ['postgres'],
      groupName: 'postgres',
    },

    // teslamate and its preconfigured Grafana are released together.
    {
      matchPackageNames: ['teslamate/teslamate', 'teslamate/grafana'],
      groupName: 'teslamate',
    },

    // Automerge, deliberately narrow: ONLY container image patches, and only
    // through the kubernetes manager, where the blast radius is a pod restart
    // that ArgoCD rolls out immediately anyway.
    //
    // Helm charts (manager "argocd") are deliberately NOT included, regardless
    // of the version jump. Green CI says nothing about upgrade paths and
    // cluster schema for charts: a Longhorn jump across several minors renders
    // cleanly and damages the storage layer, kube-prometheus-stack blocks
    // ArgoCD with a ComparisonError when the CRDs do not run ahead, and
    // MetalLB enabled FRR on every node in 0.16. All three would have passed
    // green.
    //
    // The customManager deps drop out through matchManagers already, on
    // purpose: a Talos upgrade reboots node by node and stays a deliberate act.
    {
      matchManagers: ['kubernetes'],
      matchUpdateTypes: ['patch'],
      automerge: true,
      automergeType: 'pr',
    },

    // Exceptions from automerge. They stand AFTER the rule above, because
    // later packageRules win over earlier ones.
    //
    // Databases and the document store: here the blast radius is no longer a
    // pod restart but a schema or data state, and paperless additionally holds
    // personal documents while even patch releases can carry migrations.
    {
      matchPackageNames: [
        'postgres',
        'redis',
        'ghcr.io/paperless-ngx/paperless-ngx',
      ],
      automerge: false,
    },

  ],
}
