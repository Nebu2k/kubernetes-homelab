*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/

# Virtual environments
venv/
env/
ENV/

# Ignore node_modules (if any)
node_modules/

# Ignore backup and dump files
*.dump
*.backup
*.old

# Ignore test output
coverage/

# Ignore local kube configs
.kube/

# Talos: generierte machine configs und die talosconfig enthalten die etcd- und
# Kubernetes-CAs im Klartext. Das Repo ist public, sie duerfen nie hinein.
# Versioniert werden nur talconfig.yaml (Quelle) und talsecret.sops.yaml
# (SOPS/age-verschluesselt).
talos/clusterconfig/
talos/talosconfig

# Ignore Helm release cache
.helm/

# Ignore generated update reports
update/version-report.md

# Terraform files
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
terraform.tfvars
*.tfvars

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

