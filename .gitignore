# Ignore secrets and sensitive config
.env
ROADMAP.md
NETWORK.md
*.secret.yaml
*.secrets.yaml
*-unsealed.yaml
*-private.yaml
*.pem
*.crt
*.key
*.bak
*.swp
*.swo
*.tmp
*.log

# Agent skills describe operational details and open gaps, they do not belong
# in a public repo. Still fully usable locally.
.claude/

# Ignore OS and editor files
.DS_Store
Thumbs.db

# iCloud conflict copies. ~/Documents is iCloud-synced, which produces
# duplicates of the form "pv 2.yaml" next to "pv.yaml". They are referenced by
# no kustomization and therefore harmless, which is exactly why nobody notices
# them.
* [0-9].*
.idea/
*.code-workspace

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/

# Virtual environments
venv/
env/
ENV/

# Ignore node_modules (if any)
node_modules/

# Ignore backup and dump files
*.dump
*.backup
*.old

# Ignore test output
coverage/

# Ignore local kube configs
.kube/

# Talos: the generated machine configs and the talosconfig contain the etcd and
# Kubernetes CAs in plaintext. The repo is public, they must never go in. Only
# talconfig.yaml (the source) and talsecret.sops.yaml (SOPS/age-encrypted) are
# versioned.
talos/clusterconfig/
talos/talosconfig

# Ignore Helm release cache
.helm/

# Ignore generated update reports
update/version-report.md

# Terraform files
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
terraform.tfvars
*.tfvars

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

