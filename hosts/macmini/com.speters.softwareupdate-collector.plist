<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.speters.softwareupdate-collector</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/softwareupdate-collector.sh</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StartInterval</key>
	<integer>21600</integer>
	<key>StandardOutPath</key>
	<string>/Users/speters/Library/Logs/softwareupdate-collector.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/speters/Library/Logs/softwareupdate-collector.log</string>
</dict>
</plist>
