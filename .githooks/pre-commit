#!/bin/bash

# Pre-commit hook: README.md aus apps/ und manifests/ neu generieren.
#
# Seit Juli 2026 macht .github/workflows/docs.yml dasselbe nach jedem Push auf
# main und ist die letzte Instanz. Der Hook bleibt trotzdem, weil er die
# Arbeitsteilung sauber haelt: solange er lokal laeuft, stimmt die README schon
# im eigenen Commit und die CI hat nichts nachzuschieben. Ohne ihn kaeme nach
# jedem Commit ein Bot-Commit hinterher, der vor dem naechsten Push einen Rebase
# erzwingt. Die CI greift damit nur noch bei Renovate-Merges, wo lokal niemand
# ist.
#
# Frueher lief das ueber eine conda-Umgebung namens "jinja2". Fehlte die, brach
# der Hook mit exit 1 ab und blockierte damit *jeden* Commit im Repo. Jetzt
# reicht ein python3 mit den drei Paketen aus docs-generator/requirements.txt,
# und wenn die fehlen, wird uebersprungen statt blockiert.

set -e

PYTHON="${PYTHON:-python3}"

if ! "$PYTHON" -c "import yaml, jinja2, pathspec" 2>/dev/null; then
    echo "⚠️  README-Generator übersprungen: $PYTHON fehlen Abhängigkeiten."
    echo "   Installieren mit: $PYTHON -m pip install -r docs-generator/requirements.txt"
    echo "   Die CI generiert die README nach dem Push ohnehin neu."
    exit 0
fi

echo "📝 Regenerating README.md (single point of truth)..."
# Ueber make, damit Hook und CI denselben Einstiegspunkt nutzen.
PYTHON="$PYTHON" make --no-print-directory docs

if git diff --name-only README.md | grep -q "README.md"; then
    git add README.md
    echo "✨ README.md aktualisiert und zum Commit hinzugefügt"
else
    echo "ℹ️  README.md unverändert"
fi

exit 0
